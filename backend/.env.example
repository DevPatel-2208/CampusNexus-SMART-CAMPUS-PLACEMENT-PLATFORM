# ============================================================
# CampusNexus Backend Environment Configuration
# ============================================================

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5002

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/careerconnect
# MongoDB Atlas (Production): mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/careerconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/careerconnect

# Allowed frontend origins (comma-separated). Exact matching is used in production.
CORS_ORIGIN=http://localhost:5173,https://campusnexus-placement-platform.netlify.app
# CLIENT_URL remains supported as a backward-compatible alias.

# JWT Authentication Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your-secure-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=your-secure-refresh-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email Notification Service (SMTP e.g. Brevo / SendGrid / Gmail App Password)
# In development without SMTP credentials, OTP codes are logged to backend terminal.
# In production with MAIL_REQUIRED=true, configure at least one email provider below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusNexus <no-reply@campusnexus.local>"
MAIL_REQUIRED=false

# Optional email APIs. Never commit real provider keys.
BREVO_API_KEY=
# Must be an active, verified sender address in the Brevo account.
BREVO_SENDER=
RESEND_API_KEY=

# AI Chat & Resume Analysis (Groq Cloud) - Optional
# Generates real-time interview advice & career chat. Uses fallback when blank.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional OpenAI-compatible Provider for Assessment Question Generation
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional Google OAuth 2.0 Credentials
# When configured, enables "Sign in with Google" for student accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5002/api/v1/auth/google/callback

# Dev Seed Guard (Set to false in production)
ALLOW_SEED=true
