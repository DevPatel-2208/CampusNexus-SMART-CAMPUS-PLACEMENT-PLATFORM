# ============================================================
# CampusNexus Frontend Environment Configuration
# ============================================================

# Backend API base URL. The client appends /api/v1 when it is omitted.
# Local Vite development uses its proxy:
VITE_API_BASE_URL=/api/v1

# Backward-compatible alias:
# VITE_API_URL=http://localhost:5002

# For Netlify Production Deployment:
# Set this in Netlify Site Configuration -> Environment Variables:
# VITE_API_BASE_URL=https://campusnexus-backend-7myy.onrender.com
