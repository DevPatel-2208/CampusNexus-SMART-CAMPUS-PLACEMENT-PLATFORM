{
  "name": "campusnexus",
  "version": "1.0.0",
  "private": true,
  "description": "CampusNexus — Smart Campus Placement Platform (MERN)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed:companies-jobs": "npm --prefix backend run seed:companies-jobs",
    "test:backend": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
